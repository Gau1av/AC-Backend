# Use unique, private values in backend/.env or your deployment secret manager.
ADMIN_USER=change-this-username
ADMIN_PASS=replace-with-a-long-unique-password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# The single shared login gets one role. Restart the backend and sign in again after changes.
# owner: all sections
# manager: inquiries, businesses, and graph reports
# content: blogs and comments
ADMIN_ROLE=manager
